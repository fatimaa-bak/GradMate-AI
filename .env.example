# GradMate AI Environment Variables

# ─── Database ───────────────────────────────────────────────────────────────
# Production: Supabase PostgreSQL via Supavisor pooler.
# IMPORTANT: Supabase direct connections (db.xxx.supabase.co) are IPv6-only.
# Use the session pooler for one-off admin work (db push / seed):
#   postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:5432/postgres
# Use the transaction pooler for the deployed app (Netlify):
#   postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://postgres.<PROJECT-REF>:<PASSWORD>@aws-1-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ─── NextAuth ───────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=<generate-a-long-random-string>
NEXTAUTH_URL=https://your-site.netlify.app

# ─── AI Provider ────────────────────────────────────────────────────────────
# Priority: Gemini (if key set) → z-ai-web-dev-sdk (sandbox) → demo fallback
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# Optional: model override (default gemini-4-hydrogen; alternatives: gemini-4-carbon, gemini-3.8-flash, gemini-3.5-flash-lite)
# GEMINI_MODEL=gemini-4-hydrogen
